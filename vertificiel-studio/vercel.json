{
  "framework": null,
  "functions": {
    "api/render.js": {
      "maxDuration": 60,
      "includeFiles": "img/{catalogue-*,face-base,droite-base,dalles/*}.jpg"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
